{
  "name": "goodbye-startup",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1",
    "build": "npm run content:generate && vinext build",
    "preview": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 4173",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run cf:types && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run secrets:check",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "content:generate": "node scripts/generate-content.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "wrangler": "4.158.0",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "react-server-dom-webpack": "19.3.1",
    "@mdx-js/rollup": "3.1.1",
    "@cloudflare/vite-plugin": "1.67.0",
    "@vinext/cloudflare": "1.3.3",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "miniflare": "5.20261104.0-beta",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "overrides": {
    "fflate": "0.8.3",
    "postcss-selector-parser": "6.1.6",
    "ajv-formats": {
      "ajv": "8.20.0"
    },
    "minimatch": "11.0.5"
  }
}
